		(symbol "TI-994A_CARTRIDGE_5_1"
			(text "RESET\n~{CRUCLK}\nCRU_IN\nA001\n~{GROMSEL}\nA002\nDBIN\nGROMCLK\nGROMRDY\n~{WE}\n-0.72V\n~{ROMSEL}"
				(at -16.51 0 0)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left)
				)
			)
			(text "Resets the system (active high) \nInversion of TMS9900 CRUCLOCK pin \nCRU input to TMS9900 \nGenerated address LS-bit / CRU output from TMS9900\nGROM Select, active low when address in >9800-9FFF. Internal 2.2K pull-up to +5V.\nUsed for GROM Mode select: low=data / high=addr. 2.2K pull-up to +5V. \nActive high = read memory. Internal 3.3K pull-up to +5V \nGROM Clock: 447.7kHz from the VPD. 1K pull-up to +5V.\nGROM Ready, active high. 4.7K pull-up.  Masked by ~{GROMSEL} in the console before it reaches the CPU.\nWrite Enable, active low, generated by 16-to-8 mux for each byte.\nGROM Pseudo-ground, only use with real GROM chips.\nROM Select, active low when address in >6000-7FFF.\n"
				(at -5.08 0 0)
				(effects
					(font
						(size 1.27 1.27)
					)
					(justify left)
				)
			)
